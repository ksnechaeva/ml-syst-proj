# PostgreSQL
POSTGRES_USER=fraud_user
POSTGRES_PASSWORD=fraud_pass
POSTGRES_DB=fraud_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SCORING_TOPIC=scoring

# CSV с размеченными транзакциями. Файл монтируется в data_loader и transaction_simulator.
TRAIN_DATA_CSV=./data/train.csv

# Demo defaults. For seminar-scale behaviour keep 100000 and 3.
SUPPLY_SAMPLE_SIZE=100000
HISTORY_YEARS=3
# Zero means a candidate must be no worse on either ROC-AUC or F1.
MODEL_METRIC_TOLERANCE=0.0
